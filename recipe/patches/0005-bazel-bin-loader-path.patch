From 74d69c873aa048e55f4b5e1608823f65d6f7b1c8 Mon Sep 17 00:00:00 2001
From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Sat, 12 Feb 2022 22:08:16 +0100
Subject: [PATCH 5/8] bazel bin loader path

---
 src/BUILD | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/BUILD b/src/BUILD
index fe4891e..f220979 100644
--- a/src/BUILD
+++ b/src/BUILD
@@ -326,10 +326,19 @@ genrule(
     }),
 )
 
+genrule(
+    name = "client-install-name",
+    srcs = ["//src/main/cpp:client"],
+    outs = ["client-install-name-bin"],
+    cmd = "rm -f $@; cp $(location //src/main/cpp:client) $@; chmod a+rwx $@; ${INSTALL_NAME_TOOL} -rpath ${PREFIX}/lib '@loader_path/../lib/' $@",
+    executable = 1,
+    output_to_bindir = 1,
+)
+
 [bazel_binary(
     name = "bazel-bin" + suffix,
     out = "bazel" + suffix,
-    client = "//src/main/cpp:client",
+    client = ":client-install-name",
     package_zip = "package-zip" + jdk,
     visibility = [
         "//:__pkg__",  # For distribution archive lockfile generation
