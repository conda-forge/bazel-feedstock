# Stand-in for the `grpc` module from the Bazel Central Registry.
#
# Bazel never builds gRPC from source: third_party/grpc/BUILD links conda's
# libgrpc, and the Starlark rules Bazel itself uses are vendored in
# third_party/grpc/bazel. The BCR module is pulled in only to satisfy the
# bazel_dep and to back the `cc_grpc_library` that @googleapis switches to --
# but its MODULE.bazel calls register_toolchains, which forces its root package
# to load, and gRPC's BUILD files load
# @com_google_protobuf//bazel:upb_proto_reflection_library.bzl, which protobuf
# ships as a shim forwarding to //upb/bazel -- a package our protobuf systemlib
# does not provide, so analysis fails with
#
#   ERROR: ... invalid registered toolchain
#   '//:python_3_11_ios_sim_arm64_workaround': error loading package '@@grpc+//':
#   ... Label '@@protobuf+//upb/bazel:upb_proto_reflection_library.bzl' is
#   invalid because 'upb/bazel' is not a package
#
# build.sh fills the bazel/ directory in from the grpc-bazel-rules package, so
# the rules stay in sync with conda's libgrpc, and rewrites the
# @com_github_grpc_grpc self-references in them to point at the targets in
# BUILD next to this file.
#
# The main branch does the same for 9.x.
module(
    name = "grpc",
    version = "GRPC_VERSION",
    repo_name = "io_grpc",
)

bazel_dep(name = "rules_cc", version = "0.2.15")
bazel_dep(name = "protobuf", version = "PROTOC_VERSION", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_proto", version = "7.0.2")
bazel_dep(name = "rules_shell", version = "0.4.0")
